{
  "name": "tietracker",
  "version": "3.1.0",
  "description": "A local-first time tracking app.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:e2e": "tsc && VITE_E2E=true vite build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prettier": "prettier --write 'src/**/*.{ts,js,css,html,jsx,tsx}' && prettier --write 'public/workers/**/*.{ts,js,css,html,jsx,tsx}' && prettier --write '*.md'",
    "postinstall": "jetifier",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:ios": "npx cap add ios --packagemanager CocoaPods",
    "e2e": "NODE_ENV=development playwright test",
    "e2e:ci": "playwright test --reporter=html",
    "e2e:snapshots": "playwright test --update-snapshots --reporter=list",
    "e2e:snapshots:local": "NODE_ENV=development playwright test --update-snapshots --reporter=list",
    "e2e:report": "playwright show-report",
    "e2e:playwright:install": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "@awesome-cordova-plugins/core": "^9.4.0",
    "@awesome-cordova-plugins/file": "^9.4.0",
    "@awesome-cordova-plugins/local-notifications": "^9.4.0",
    "@awesome-cordova-plugins/social-sharing": "^9.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ionic/react": "^9.0.10",
    "@ionic/react-router": "^9.0.10",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/styles": "^6.5.0",
    "@mui/x-date-pickers": "^9.11.0",
    "cordova-plugin-badge": "^0.8.9",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-local-notification": "^1.2.3",
    "cordova-plugin-x-socialsharing": "^6.0.4",
    "date-fns": "^4.4.0",
    "es6-promise-plugin": "^4.2.2",
    "exceljs": "^4.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.3.0",
    "ionicons": "^8.1.0",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-redux": "^9.3.0",
    "react-router": "^6",
    "react-router-dom": "^6",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-redux": "^7.1.34",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "globals": "^17.9.0",
    "jetifier": "^2.0.0",
    "kyushu-types": "^0.2.1",
    "node-fetch": "^3.3.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.102.0",
    "typescript": "6.0.3",
    "vite": "^8.3.5"
  },
  "homepage": "https://tietracker.com",
  "author": "David Dal Busco",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git://github.com/peterpeterparker/tietracker.git"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
